# Copy to .env (repo root) or crisis_command/agents/.env and fill in. .env is git-ignored; never commit keys.

# ----- Meta models (one key for all of them) -----
META_API_KEY=""
META_BASE_URL="https://api.meta.ai/v1/responses"
META_MODEL="muse-spark-1.3"
META_VOICE_MODEL="muse-voice-transcribe-1.0"
META_SAM_MODEL="sam-3.1"
META_SAM_URL="https://api.meta.ai/v1/responses"
META_WONDER_MODEL="muse-wonder-1.0"
META_WONDER_URL="https://api.meta.ai/v1/responses"
META_IMAGE_MODEL="muse-image-1.0"
META_IMAGE_URL="https://api.meta.ai/v1/images/generations"
# live = call the models (and record answers); demo = replay recorded answers only
META_MODE="live"

# ----- Mode -----
# false (default): live intake only. true: the seeded Richmond flood, played one step at a time from the Demo control.
DEMO_ENABLED="false"

# ----- Incoming reports -----
# If set, POST /api/intake requires "Authorization: Bearer <token>".
INTAKE_TOKEN=""
# Optional database connector: polls a table with columns id, text, source.
# sqlite:///C:/path/to/reports.db  or  postgresql://user:pass@host/db (needs: pip install psycopg)
CONNECTOR_SQL_URL=""
CONNECTOR_SQL_TABLE="incoming_reports"
CONNECTOR_POLL_SECONDS="5"
