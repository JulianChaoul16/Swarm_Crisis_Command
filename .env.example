# Placeholders only; never commit real values. Copy to .env (repo root) or set in your shell.
# Without these the app runs with model-backed steps marked "unavailable".
META_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1/responses
# Optional: minimal | low | medium | high | xhigh (default low)
META_REASONING_EFFORT=

# --- Other Meta models (fill in what your account can access; leave blank if not) ---
# One key (META_API_KEY above) covers all of them; each needs its model ID, and its
# endpoint if it differs from META_BASE_URL. Local open-weights models need their local URL.
# Listener Agent: speech to text (input: audio)
META_VOICE_MODEL=
META_VOICE_URL=
# Vision Agent: segmentation (input: image + text prompts) and image reasoning (input: image + text)
META_SAM_MODEL=
META_SAM_URL=
META_WONDER_MODEL=
META_WONDER_URL=
# Logistics Agent: local open-weights model for retrieval-augmented answers
META_GLIMMER_MODEL=
META_GLIMMER_URL=
# Triage Agent: local open-weights model for PII redaction before cloud calls
META_SPARK_OPEN_MODEL=
META_SPARK_OPEN_URL=
# Comms Agent: image generation for the alert graphic
META_IMAGE_MODEL=
META_IMAGE_URL=
# live = call models (default); demo = replay recorded answers only
META_MODE=
