{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": ["/crisis_command/**", "/demo_cache/**", "/test_media/**", "/requirements.txt", "/.python-version", "/railway.json"]
  },
  "deploy": {
    "startCommand": "python -m uvicorn crisis_command.api.server:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/api/state",
    "healthcheckTimeout": 180,
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
